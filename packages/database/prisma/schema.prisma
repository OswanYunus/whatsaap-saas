generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InstanceStatus {
  PENDING
  CONNECTING
  CONNECTED
  DISCONNECTED
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspaces   WorkspaceMember[]
}

model Workspace {
  id          String              @id @default(cuid())
  name        String
  createdAt   DateTime            @default(now())

  members     WorkspaceMember[]
  instances   Instance[]
  contacts    Contact[]
  campaigns   Campaign[]
  apiKeys     WorkspaceApiKey[]
}

model WorkspaceMember {
  id          String      @id @default(cuid())

  userId      String
  workspaceId String

  role        Role        @default(MEMBER)

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Instance {
  id            String           @id @default(cuid())
  workspaceId   String

  name          String
  phoneNumber   String?
  sessionId     String?          @unique
  status        InstanceStatus   @default(PENDING)

  createdAt     DateTime         @default(now())

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  apiKeys       ApiKey[]
  messages      Message[]
  campaigns     Campaign[]
}

model ApiKey {
  id          String      @id @default(cuid())
  instanceId  String

  key         String      @unique
  createdAt   DateTime    @default(now())

  instance    Instance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model Message {
  id           String         @id @default(cuid())
  instanceId   String

  to           String
  body         String

  status       MessageStatus  @default(QUEUED)

  createdAt    DateTime       @default(now())

  sentAt       DateTime?

  instance     Instance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  // Optional: set when this message was generated by a campaign send
  // rather than a one-off/manual send. Nullable so any existing rows
  // (and any direct instance -> message flow) keep working unchanged.
  campaignId   String?
  contactId    String?

  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
}

model Contact {
  id          String    @id @default(cuid())
  workspaceId String

  name        String
  phone       String
  groupName   String?

  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([workspaceId, phone])
}

model Campaign {
  id              String         @id @default(cuid())
  workspaceId     String
  instanceId      String

  name            String
  // The message text sent to every recipient. Kept simple (no
  // templating/variables) for this iteration.
  messageTemplate String

  status          CampaignStatus @default(DRAFT)
  createdAt       DateTime       @default(now())

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance        Instance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages        Message[]
}

// Workspace-level API key, separate from the existing instance-scoped
// ApiKey model above (left untouched). Unlike that model, only a hash
// of the key is stored — the raw value is returned once at creation
// time and can never be retrieved again. This is the standard pattern
// for keys meant to authenticate external API callers.
model WorkspaceApiKey {
  id          String    @id @default(cuid())
  workspaceId String

  label       String
  keyHash     String    @unique
  // First few characters of the raw key, shown in the UI so a user
  // can tell keys apart without re-exposing the secret.
  keyPrefix   String

  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}