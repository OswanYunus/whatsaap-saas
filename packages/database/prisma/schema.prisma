generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InstanceStatus {
  PENDING
  CONNECTING
  CONNECTED
  DISCONNECTED
  QR_WAITING
  PAIRING_CODE
  RECONNECTING
  LOGGED_OUT
  ERROR
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum AudienceType {
  ALL
  GROUP
  TAGS
  MANUAL
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  passwordHash               String
  name                       String              @default("")
  phoneNumber                String              @default("")
  isVerified                 Boolean             @default(false)
  verificationCode           String?
  verificationCodeExpiresAt  DateTime?
  resetPasswordCode          String?
  resetPasswordCodeExpiresAt DateTime?
  isAdmin                    Boolean             @default(false)
  isBlocked                  Boolean             @default(false)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  workspaces   WorkspaceMember[]
}

model Workspace {
  id          String              @id @default(cuid())
  name        String
  createdAt   DateTime            @default(now())

  members     WorkspaceMember[]
  instances   Instance[]
  contacts    Contact[]
  campaigns   Campaign[]
  apiKeys     ApiKey[]
  apiRequestLogs DeveloperApiRequestLog[]
  templates   CampaignTemplate[]
  settings    WorkspaceSettings?
}

model WorkspaceMember {
  id          String      @id @default(cuid())

  userId      String
  workspaceId String

  role        Role        @default(MEMBER)

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model WorkspaceSettings {
  id            String    @id @default(cuid())
  workspaceId   String    @unique

  softwareName  String    @default("Cerebro")
  footerEnabled Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Instance {
  id            String           @id @default(cuid())
  workspaceId   String

  name          String
  phoneNumber   String?
  sessionId     String?          @unique
  status        InstanceStatus   @default(PENDING)

  qrCodeString  String?
  pairingCode   String?
  qrExpiresAt   DateTime?
  lastSeenAt    DateTime?
  lastError     String?
  displayName   String?

  createdAt     DateTime         @default(now())

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  apiKeys       InstanceApiKey[]
  messages      Message[]
  campaigns     Campaign[]
  templates     CampaignTemplate[]
  baileysAuths  BaileysAuth[]
}

model BaileysAuth {
  id         String   @id @default(cuid())
  instanceId String
  key        String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, key])
}

model InstanceApiKey {
  id          String      @id @default(cuid())
  instanceId  String

  key         String      @unique
  createdAt   DateTime    @default(now())

  instance    Instance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("ApiKey")
}

model Message {
  id            String         @id @default(cuid())
  publicId      String?        @unique
  instanceId    String

  to            String
  body          String

  status        MessageStatus  @default(QUEUED)
  failureReason String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sentAt        DateTime?

  instance      Instance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  campaignId    String?
  contactId     String?

  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

model Contact {
  id            String         @id @default(cuid())
  workspaceId   String

  name          String?
  phone         String?

  fullName      String
  phoneNumber   String
  groupName     String?
  tags          String[]       @default([])
  notes         String?
  status        ContactStatus  @default(ACTIVE)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([workspaceId, phoneNumber])
}

/// Defines a recurring schedule. Each execution spawns a new Campaign run.
model CampaignTemplate {
  id                String       @id @default(cuid())
  publicId          String?      @unique
  workspaceId       String
  instanceId        String

  name              String
  notes             String?
  messageTemplate   String

  audienceType      AudienceType @default(ALL)
  audienceGroupName String?
  audienceTags      String[]     @default([])

  isActive          Boolean      @default(true)
  cronExpression    String
  timezone          String       @default("UTC")

  minDelaySeconds   Int          @default(4)
  maxDelaySeconds   Int          @default(9)
  maxPerMinute      Int          @default(12)
  footerEnabled     Boolean      @default(true)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance          Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  runs              Campaign[]
}

model Campaign {
  id                String         @id @default(cuid())
  publicId          String?        @unique
  workspaceId       String
  instanceId        String

  name              String
  messageTemplate   String
  notes             String?

  audienceType      AudienceType   @default(ALL)
  audienceGroupName String?
  audienceTags      String[]       @default([])

  status            CampaignStatus @default(DRAFT)

  scheduledAt       DateTime?
  timezone          String?
  isRecurring       Boolean        @default(false)
  cronExpression    String?
  templateId        String?

  minDelaySeconds   Int            @default(4)
  maxDelaySeconds   Int            @default(9)
  maxPerMinute      Int            @default(12)
  footerEnabled     Boolean        @default(true)

  startedAt         DateTime?
  completedAt       DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance          Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  template          CampaignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages          Message[]
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String

  name        String    @map("label")
  keyHash     String    @unique
  keyPrefix   String

  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs        DeveloperApiRequestLog[]

  @@map("WorkspaceApiKey")
}

model DeveloperApiRequestLog {
  id           String    @id @default(cuid())
  workspaceId  String?
  apiKeyId     String?
  endpoint     String
  method       String
  ip           String?
  success      Boolean
  responseCode Int
  createdAt    DateTime  @default(now())

  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  apiKey       ApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([apiKeyId, createdAt])
}
