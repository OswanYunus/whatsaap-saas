# Copy to /opt/whatsapp-saas/.env on the VPS (never commit the real file).
# Frontend stays on Vercel — this file is backend-only.

NODE_ENV=production
API_PORT=4000
API_HOST=0.0.0.0

# PostgreSQL (installed on the same VPS)
DATABASE_URL=postgresql://waas_user:CHANGE_ME@localhost:5432/waas_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Generate each secret on your PC:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d
