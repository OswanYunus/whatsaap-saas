# ─── Cerebro Production Environment ────────────────────────────────
# Copy this file to .env.prod on your VPS and fill in every value.
# NEVER commit .env.prod to git.

# ── Domain ──────────────────────────────────────────────────────────
# Your domain or free subdomain (e.g. cerebro.yourdomain.com)
# If using a free subdomain service, put that here.
DOMAIN=cerebro.yourdomain.com

# Email for Let's Encrypt SSL certificate notifications
ACME_EMAIL=you@example.com

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=cerebro_user
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=cerebro_db

# ── Redis ───────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password_here

# ── JWT Secrets ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=generate_64_char_hex_here
JWT_REFRESH_SECRET=generate_different_64_char_hex_here
