{
  "name": "whatsapp-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @waas/api dev",
    "dev:web": "pnpm --filter @waas/web dev",
    "dev:worker": "pnpm --filter @waas/api dev:worker",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @waas/database generate",
    "db:migrate": "pnpm --filter @waas/database migrate",
    "db:studio": "pnpm --filter @waas/database studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.7.0"
}